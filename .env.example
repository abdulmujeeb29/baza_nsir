# LLM used by the app at runtime. Never commit the real .env file.
LLM_PROVIDER=azure            # azure | openai | gemini | anthropic
LLM_MODEL=your-model-or-deployment-name
LLM_API_KEY=
LLM_BASE_URL=                 # required for azure, e.g. https://<resource>.services.ai.azure.com/openai/v1
APP_ENV=production
# Optional
# RATE_LIMIT_PER_MINUTE=20
# ASK_TIMEOUT_SECONDS=45
